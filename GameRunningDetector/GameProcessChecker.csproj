<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <AssemblyName>GameProcessChecker</AssemblyName>
    <RootNamespace>GameProcessChecker</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Registry API được đánh dấu chỉ chạy trên Windows; tool này chỉ dành cho Windows -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <!-- Một exe Windows độc lập, không yêu cầu máy đích cài .NET Runtime. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>

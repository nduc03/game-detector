<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>False</UseWindowsForms>
    <TargetFramework>net10.0-windows</TargetFramework>

    <AssemblyName>GameProcessChecker</AssemblyName>
    <RootNamespace>GameProcessChecker</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Registry API được đánh dấu chỉ chạy trên Windows; tool này chỉ dành cho Windows -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <!-- Một exe Windows độc lập, không yêu cầu máy đích cài .NET Runtime. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <DebugType>portable</DebugType>
	<InvariantGlobalization>true</InvariantGlobalization>
	<PublishAot>true</PublishAot>
  </PropertyGroup>


  <ItemGroup>
    <None Update="games.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

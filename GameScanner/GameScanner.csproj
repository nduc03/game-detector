<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: mở GUI không kèm cửa sổ console; chế độ dòng lệnh/pipe vẫn chạy qua stdin/stdout (xem Cli/CliRunner.cs). -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Cho phép build/kiểm tra cú pháp trên máy không phải Windows; không ảnh hưởng khi build trên Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <AssemblyName>GameScanner</AssemblyName>
    <RootNamespace>GameScanner</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Registry API được đánh dấu chỉ chạy trên Windows; tool này chỉ dành cho Windows -->
    <NoWarn></NoWarn>

    <!-- Một exe Windows độc lập, không yêu cầu máy đích cài .NET Runtime. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <StartupObject>GameScanner.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <None Update="rules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
